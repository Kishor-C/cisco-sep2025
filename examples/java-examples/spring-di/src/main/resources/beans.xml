<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.0.xsd">

	<bean id = "mysqlDAO" class = "com.cisco.dao.StudentRepositoryMySQLImpl">
		<property name="databaseVersion" value = "8.0"></property>
	</bean>
	
	<bean id = "oracleDAO" class = "com.cisco.dao.StudentRepositoryOracleImpl">
		<property name="databaseVersion" value = "14.0"></property>
	</bean>
	
	<bean id = "mongoDAO" class = "com.cisco.dao.StudentRepositoryMongoImpl">
		<property name="databaseVersion" value = "6.5.0"></property>
	</bean>
	
	<bean id = "service" class = "com.cisco.service.StudentServiceImpl">
		<property name="repo" ref = "oracleDAO"></property>
	</bean>
	
	<bean id = "service2" class = "com.cisco.service.EmployeeServiceImpl" autowire="byType">
	</bean>
</beans>